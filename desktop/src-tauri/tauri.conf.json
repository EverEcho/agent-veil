{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentVeil",
  "version": "0.1.0",
  "identifier": "com.agentveil.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [{ "label": "main", "title": "AgentVeil", "width": 1180, "height": 800, "minWidth": 820, "minHeight": 600, "center": true }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources"],
    "icon": ["icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Local privacy control plane for AI agents"
  }
}
